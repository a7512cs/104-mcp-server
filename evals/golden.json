      "category": "search-basic",
      "utterance": "幫我找新竹的 DevOps 職缺",
      "expect": {
        "tool": "search_jobs",
        "args": [
          {
            "arg": "keyword",
            "contains": "DevOps"
          },
          {
            "arg": "area",
            "contains": "新竹"
          },
          {
            "arg": "salaryMin",
            "absent": true
          },
          {
            "arg": "sort",
            "absent": true
          },
          {
            "arg": "excludeFeatured",
            "notEquals": true
          },
          {
            "arg": "excludeNegotiable",
            "notEquals": true
          }
        ]
      }
    },
